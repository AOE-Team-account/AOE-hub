# Copy this file to .env.local and fill in the real values. .env.local is
# gitignored — never commit real keys.

# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-side only, bypasses Row Level Security. Never expose this
# to the browser (no NEXT_PUBLIC_ prefix) or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare R2 (small files) ---
# R2 → Manage API tokens → Create Account API token, Object Read & Write,
# scoped to one bucket.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name

# --- Internet Archive (large files) ---
# Get these from https://archive.org/account/s3.php once logged in — no
# bucket to create ahead of time, it's made automatically on first upload.
IA_ACCESS_KEY=your-ia-access-key
IA_SECRET_KEY=your-ia-secret-key
IA_BUCKET_NAME=your-chosen-item-name

# --- Virus scanner (ClamAV on Google Cloud Run) and the private staging bucket ---
# Uploads wait in R2_STAGING_BUCKET_NAME (a separate bucket with a 1-day auto-delete rule)
# until the scanner has checked them. SCANNER_SECRET must be at least 24 random characters
# and is also given to the scanner service when it is deployed.
R2_STAGING_BUCKET_NAME=aoehub-staging
SCANNER_URL=https://your-scanner-url.run.app
SCANNER_SECRET=a-long-random-secret

# --- Cron protection ---
# Any long random string — protects /api/cron/check-pending-scans from
# being triggered by anyone who finds the URL. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=a-long-random-string

# --- Test site or official site ---
# On the TEST site (aoe.name) set SITE_PRIVATE=true: every page tells search
# engines not to list it, and robots.txt refuses everything. On the OFFICIAL
# site (aoe.ai) leave it out and set NEXT_PUBLIC_SITE_URL so the normal
# robots.txt and sitemap are published.
SITE_PRIVATE=true
NEXT_PUBLIC_SITE_URL=https://aoe.name

# --- AI assistant ---
# The hub's own keys are added by the Creator in the Creator panel (the hub
# tries Google Gemini, then Groq, then Qwen). The settings below are only a
# fallback for development on your own computer, using a local Ollama model.
# Do NOT set them on the live site: "localhost" only works on your own machine.
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_CHAT_MODEL=gemma4:latest

# Optional environment keys for the same providers (the Creator panel is the normal way):
# GOOGLE_AI_API_KEY=
# GROQ_API_KEY=

# Embedding model: turns posts, books and questions into vectors. The database
# column is 768 dimensions, so the model must produce 768 (or be told to).
# Changing this model means re-indexing (the Creator panel's "Update index" button does it).
# nomic-embed-text (local): run `ollama pull nomic-embed-text` first.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# nomic-embed-text wants these prefixes; leave both empty for models that don't.
EMBEDDING_DOC_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "

# Optional: minimum cosine similarity for a passage to count as relevant (default 0.4).
# AI_MIN_SIMILARITY=0.4

# --- Alert emails (storage alert, scan problems) ---
# BREVO_API_KEY=
# ALERT_EMAIL_TO=
