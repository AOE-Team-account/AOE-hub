# Copy this file to .env.local and fill in the real values. .env.local is
# gitignored — never commit real keys.

# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-side only, bypasses Row Level Security. Never expose this
# to the browser (no NEXT_PUBLIC_ prefix) or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare R2 (small files) ---
# R2 → Manage API tokens → Create Account API token, Object Read & Write,
# scoped to one bucket.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name

# --- Internet Archive (large files) ---
# Get these from https://archive.org/account/s3.php once logged in — no
# bucket to create ahead of time, it's made automatically on first upload.
IA_ACCESS_KEY=your-ia-access-key
IA_SECRET_KEY=your-ia-secret-key
IA_BUCKET_NAME=your-chosen-item-name

# --- VirusTotal (malware scanning gate) ---
# Free account → profile icon → API Key.
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# --- Cron protection ---
# Any long random string — protects /api/cron/check-pending-scans from
# being triggered by anyone who finds the URL. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=a-long-random-string

# --- AI assistant (Phase 5) ---
# The hub's DEFAULT model, used for anyone who hasn't added their own key.
# AI_PROVIDER is "openai-compatible" (covers Ollama, vLLM, Google's Gemini
# endpoint, OpenAI, ...) or "anthropic". Swapping models is only ever a change
# here — no code changes.
#   Local Ollama:  AI_BASE_URL=http://localhost:11434/v1   (no key needed)
#   Google Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  + AI_API_KEY
# NOTE: "localhost" only works while developing on your own machine. The live
# site needs an endpoint the hosting server can actually reach.
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_CHAT_MODEL=gemma4:latest

# Embedding model — turns posts/books/questions into vectors. Separate from the
# chat model (Anthropic has no embeddings API, for one). The database column is
# 768 dimensions, so the model must produce 768 (or be told to). Changing this
# model means re-indexing: the admin "Update index" button does it automatically.
# nomic-embed-text: run `ollama pull nomic-embed-text` first.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# nomic-embed-text wants these prefixes; leave both empty for models that don't.
EMBEDDING_DOC_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "

# Optional: minimum cosine similarity for a passage to count as relevant (default 0.4).
# AI_MIN_SIMILARITY=0.4
