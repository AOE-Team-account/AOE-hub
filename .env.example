# Copy this file to .env.local and fill in the real values from your
# Supabase project (Dashboard → Project Settings → API). .env.local is
# gitignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-side only, bypasses Row Level Security. Never expose this
# to the browser (no NEXT_PUBLIC_ prefix) or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
