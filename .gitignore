# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private working documents (kept on Clara's computer only, never on GitHub)
/RECOVERY.md
/MARKETPLACE-UPDATE.md
/hub-prototype2.html
/AOEhub *.md
/policy-review/

# macOS copy leftovers (AppleDouble files)
._*

# database dumps and backups never belong in git
*.dump
*.sql.gz
*.age
